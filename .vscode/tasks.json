{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "bun",
            "script": "prepare",
            "label": "Compile TypeScript",
            "problemMatcher": [
                "$tsc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "bun",
            "script": "run test",
            "options": {
                "env": {
                    "AGENT": "1"
                }
            },
            "problemMatcher": [],
            "label": "Run tests",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "type": "bun",
            "script": "run test:modern",
            "problemMatcher": [],
            "label": "Run modern tests",
            "group": "test"
        },
        {
            "type": "shell",
            "command": "bun run test:legacy",
            "problemMatcher": [],
            "label": "Run legacy tests",
            "group": "test"
        }
    ]
}
