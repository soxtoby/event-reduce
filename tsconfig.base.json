{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2024", "ESNext.Collection", "ESNext.Iterator", "ESNext.Disposable", "dom"],
    "jsx": "react-jsx",
    "strict": true, 
    "noImplicitOverride": true,
    "sourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "event-reduce": ["./packages/event-reduce/src/index.ts"],
      "event-reduce/lib/*": ["./packages/event-reduce/src/*"],
      "event-reduce-react": ["./packages/event-reduce-react/src/index.ts"],
      "event-reduce-react/lib/*": ["./packages/event-reduce-react/src/*"]
    }
  }
}
