{
    "name": "event-reduce-root",
    "description": "State management based on reducing observable events into state",
    "version": "1.0.0",
    "license": "MIT",
    "private": true,
    "author": "Simon Oxtoby",
    "homepage": "https://github.com/soxtoby/event-reduce",
    "repository": {
        "type": "git",
        "url": "https://github.com/soxtoby/event-reduce.git"
    },
    "workspaces": [
        "packages/*",
        "tests",
        "tests-legacy",
        "example"
    ],
    "scripts": {
        "prepare": "tsc -b",
        "watch": "tsc -b -w",
        "check": "bun check -b",
        "test:modern": "bun test",
        "test:legacy": "bun test --config=bunfig.legacy.toml --tsconfig-override=tests-legacy/tsconfig.json",
        "test": "bun run test:modern && bun run test:legacy",
        "example": "bun example/serve.ts",
        "prepare-release": "bun scripts/prepare-release.ts"
    },
    "devDependencies": {
        "typescript": "~6.0.3"
    },
    "resolutions": {
        "deasync": "0.1.30"
    }
}
