{
    // A copy of tsconfig.base.json instead of extending it,
    // because Bun ignores experimentalDecorators in a config that uses "extends".
    "compilerOptions": {
        "target": "es2024",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ES2024", "ESNext.Collection", "ESNext.Iterator", "ESNext.Disposable", "dom"],
        "jsx": "react-jsx",
        "strict": true,
        "noImplicitOverride": true,
        "sourceMap": true,
        "inlineSources": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "outDir": "./dist",
        "rootDir": ".",
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "paths": {
            "event-reduce": ["../packages/event-reduce/src/index.ts"],
            "event-reduce/lib/*": ["../packages/event-reduce/src/*"]
        }
    },
    "references": [
        {
            "path": "../packages/event-reduce"
        }
    ],
    "include": [
        "./**/*.ts",
        "./**/*.tsx"
    ]
}
